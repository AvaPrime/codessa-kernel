{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codessa.dev/schemas/authority-metadata.schema.json",
  "schema_version": "1.0.0",
  "title": "Codessa Authority Metadata",
  "type": "object",
  "required": ["schema_version", "statements"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "statements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "derives_from", "enforcement", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9]+-[A-Z0-9]+-[0-9]{3}$|^AXIOM-[0-9]{3}$|^INV-[0-9]{3}$"
          },
          "derives_from": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "enforcement": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["Planned", "Executable"]
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
